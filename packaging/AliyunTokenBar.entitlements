<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 硬化运行时(签名要求)。
	     Sparkle 已于 v1.0.8 移除,App 不再依赖任何第三方 framework,
	     故不再需要 disable-library-validation / allow-unsigned-executable-memory——
	     收紧权限,减小攻击面。

	     通知(UserNotifications)与 Keychain 不需要额外 entitlement:
	     通知由运行时授权弹窗覆盖;Keychain 默认对同 bundle id 可访问。 -->
</dict>
</plist>
